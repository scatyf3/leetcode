  "quiz": {
    "q": "命中 cur.val == val 后，指针怎么动？",
    "idea": "prev.next = cur.next，cur = prev.next，prev 不动",
    "wrong": [
      "prev.next = cur.next，cur = prev.next.next，prev 不动",
      "prev.next = cur.next，cur 和 prev 都前进一步",
